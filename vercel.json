{
  "version": 2,
  "builds": [
    {
      "src": "test5/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "test5/dist"
      }
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/test5/$1"
    }
  ],
  "outputDirectory": "test5/dist"
}
