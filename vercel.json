{
  "version": 2,
  "functions": {
    "api/server.js": {
      "runtime": "nodejs20.x"
    }
  },
  "builds": [
    {
      "src": "test5/package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/test5/$1"
    }
  ]
}